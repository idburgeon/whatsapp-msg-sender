# Server Configuration
PORT=3000
API_KEY=your_secure_api_key_here

# WhatsApp Configuration
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/96.0.4664.110 Safari/537.36

# Image Storage
IMAGE_DIR=./images
IMAGE_RETENTION_DAYS=1
AA_WAPP_KEY=92b6448a71226d2b01a56234b28275f19c1a0dc3ad132bc02ba07954abbd8fa7
AA_WAPP_API=https://api-nepal.all-attend.com/api

# Connection resilience
# How long a send waits for WhatsApp to reconnect before failing (ms)
WA_CONNECT_WAIT_MS=30000
# A single send taking longer than this counts as failed (ms)
WA_SEND_TIMEOUT_MS=120000
# Down longer than this -> process exits and pm2 restarts it (ms)
WA_MAX_DOWNTIME_MS=600000
# Optional Slack/Discord webhook for "needs human" alerts (logged out, restart)
ALERT_WEBHOOK_URL=
